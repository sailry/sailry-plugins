{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "token": {
      "type": "string",
      "title": "Token",
      "minLength": 1,
      "maxLength": 4096,
      "x-sailry-secret": {
        "server": "github",
