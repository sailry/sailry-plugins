    "de": {"token": "Token"},
    "es": {"token": "Token"},
    "fr": {"token": "Jeton"},
    "ja": {"token": "トークン"},
    "ko": {"token": "토큰"},
    "pt-BR": {"token": "Token"},
    "ru": {"token": "Токен"}
  }
