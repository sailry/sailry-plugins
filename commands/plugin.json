{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "commands",
  "version": "0.1.24",
  "extensions": {
    "dev.sailry.platform": {
      "min_sailry_version": "0.1.6",
      "api_version": "v1",
      "actions": [
        "terminals.read",
        "terminals.control"
      ],
      "display": {
        "label": "Commands",
        "locales": {
          "zh-CN": "命令"
        },
        "icon": "phosphor:terminal"
      },
      "description": {
        "label": "Run commands and manage terminals",
        "locales": {
          "zh-CN": "执行命令与管理终端"
        }
      },
      "desktop": {
        "entry": "dev.sailry.platform/desktop/main.js",
        "ui_entry": "dev.sailry.platform/desktop/project.js",
        "renderers": [
          {
            "resource": "terminal",
            "create": "terminal-new",
            "shortcut": "ctrl-`"
          }
        ],
        "resources": [
          "dev.sailry.platform/desktop/main.js",
          "dev.sailry.platform/desktop/project.js",
          "dev.sailry.platform/desktop/view.js",
          "dev.sailry.platform/desktop/access.js",
          "dev.sailry.platform/desktop/labels.js",
          "dev.sailry.platform/desktop/exit.js",
          "dev.sailry.platform/desktop/locales.js"
        ],
        "panel": {
          "label": "Terminal",
          "locales": {
            "zh-CN": "终端"
          },
          "icon": "reicon:it/terminal-square"
        }
      },
      "ui": [
        {
          "id": "terminal-cli",
          "slot": "project",
          "kind": "menu",
          "label": {
            "label": "CLI",
            "locales": {
              "zh-CN": "CLI"
            }
          },
          "icon": "square-terminal",
          "order": 10,
          "handler": "cli"
        },
        {
          "id": "terminal-new",
          "slot": "project",
          "kind": "button",
          "label": {
            "label": "New terminal",
            "locales": {
              "zh-CN": "新建终端"
            }
          },
          "icon": "square-terminal",
          "order": 20,
          "handler": "create"
        },
        {
          "id": "terminal-menu-new",
          "slot": "project_menu",
          "kind": "button",
          "label": {
            "label": "New terminal",
            "locales": {
              "zh-CN": "新建终端"
            }
          },
          "icon": "square-terminal",
          "order": 10,
          "handler": "create"
        },
        {
          "id": "terminal-menu-cli",
          "slot": "project_menu",
          "kind": "menu",
          "label": {
            "label": "CLI",
            "locales": {
              "zh-CN": "CLI"
            }
          },
          "icon": "square-terminal",
          "order": 20,
          "handler": "cli"
        }
      ],
      "category": "development",
      "tint": "teal"
    }
  }
}
