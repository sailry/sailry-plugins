{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "context7",
  "version": "0.1.3",
  "description": "Current library documentation through the official Context7 MCP service",
  "homepage": "https://context7.com",
  "extensions": {
    "dev.sailry.platform": {
      "api_version": "v1",
      "scope": "host",
      "actions": [],
      "display": {
        "label": "Context7",
        "locales": {
          "zh-CN": "Context7"
        },
        "icon": "reicon:newicons/book-square"
      },
      "description": {
        "label": "Current library documentation",
        "locales": {
          "zh-CN": "查询最新库文档"
        }
      },
      "tools": [
        {
          "name": "resolve-library-id",
          "server": "context7",
          "display": {
            "label": "Find library",
            "locales": {
              "zh-CN": "查找库",
              "zh-TW": "尋找程式庫",
              "ja": "ライブラリを探す",
              "ko": "라이브러리 찾기",
              "fr": "Trouver une bibliothèque",
              "de": "Bibliothek suchen",
              "es": "Buscar biblioteca",
              "pt-BR": "Buscar biblioteca",
              "ru": "Найти библиотеку",
              "en": "Find library"
            },
            "icon": "reicon:ui/magnifier"
          }
        },
        {
          "name": "query-docs",
          "server": "context7",
          "display": {
            "label": "Read documentation",
            "locales": {
              "zh-CN": "查询文档",
              "zh-TW": "讀取文件",
              "ja": "ドキュメントを読む",
              "ko": "문서 읽기",
              "fr": "Lire la documentation",
              "de": "Dokumentation lesen",
              "es": "Leer documentación",
              "pt-BR": "Ler documentação",
              "ru": "Прочитать документацию",
              "en": "Read documentation"
            },
            "icon": "reicon:newicons/book-square"
          }
        }
      ],
      "settings_schema": "dev.sailry.platform/settings.json",
      "category": "development",
      "tint": "teal"
    }
  }
}
