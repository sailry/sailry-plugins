{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "worktrees",
  "version": "0.1.21",
  "extensions": {
    "dev.sailry.platform": {
      "api_version": "v1",
      "min_sailry_version": "0.2.13",
      "products": ["harness", "code"],
      "requires_modules": ["worktrees"],
      "actions": [
        "worktrees.read",
        "worktrees.write",
        "git.read",
        "conversation.control"
      ],
      "display": {
        "label": "Worktrees",
        "locales": {
          "zh-CN": "工作树"
        },
        "icon": "phosphor:tree-structure"
      },
      "description": {
        "label": "Manage project worktrees",
        "locales": {
          "zh-CN": "管理项目工作树"
        }
      },
      "desktop": {
        "entry": "dev.sailry.platform/desktop/main.js",
        "ui_entry": "dev.sailry.platform/desktop/main.js",
        "ui_overlay": true,
        "resources": [
          "dev.sailry.platform/desktop/main.js",
          "dev.sailry.platform/desktop/controller.js",
          "dev.sailry.platform/desktop/policy.js",
          "dev.sailry.platform/desktop/view.js",
          "dev.sailry.platform/desktop/locales.js"
        ]
      },
      "ui": [
        {
          "id": "location",
          "slot": "context",
          "kind": "menu",
          "label": {
            "label": "Worktree",
            "locales": {
              "zh-CN": "工作区"
            }
          },
          "icon": "folder",
          "handler": "location",
          "order": -10
        },
        {
          "id": "manage",
          "slot": "project_menu",
          "kind": "button",
          "label": {
            "label": "Manage worktrees…",
            "locales": {
              "zh-CN": "管理工作树…"
            }
          },
          "icon": "network",
          "handler": "manage",
          "intent": "worktrees",
          "order": 30
        },
        {
          "id": "create",
          "slot": "composer",
          "kind": "button",
          "label": {
            "label": "Create worktree and continue",
            "locales": {
              "zh-CN": "新建工作树并继续"
            }
          },
          "icon": "plus",
          "handler": "create",
          "intent": "create_worktree",
          "order": 30,
          "overflow": "menu"
        },
        {
          "id": "fork",
          "slot": "composer",
          "kind": "button",
          "label": {
            "label": "Fork in a separate worktree",
            "locales": {
              "zh-CN": "在独立工作树中派生会话"
            }
          },
          "icon": "plus",
          "handler": "fork",
          "intent": "fork_worktree",
          "order": 40,
          "overflow": "menu"
        }
      ],
      "category": "development",
      "tint": "blue"
    }
  }
}
