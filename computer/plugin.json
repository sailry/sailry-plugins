      "permissions": [
        {
          "kind": "accessibility",
          "subject": "dev.sailry.computer",
          "check": "check",
          "request": "request",
          "request_group": "ocu-onboarding",
          "actions": [
            "computer.read",
            "computer.control"
          ]
        },
        {
          "kind": "screen_recording",
          "subject": "dev.sailry.computer",
          "check": "check",
          "request": "request",
          "request_group": "ocu-onboarding",
          "actions": [
            "computer.read",
            "computer.control"
          ]
        }
      ],
      "host": {
        "entry": "dev.sailry.platform/host/permissions.js",
        "resources": [
          "dev.sailry.platform/host/permissions.js"
        ],
        "handlers": [
          "check",
          "request"
        ],
        "read_only": [
          "check"
        ]
      }
    }
  },
  "homepage": "https://github.com/ifuryst/open-computer-use"
}
