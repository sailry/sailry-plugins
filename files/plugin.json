{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "files",
  "version": "0.1.34",
  "extensions": {
    "dev.sailry.platform": {
      "api_version": "v1",
      "min_sailry_version": "0.2.14",
      "products": ["harness", "code"],
      "requires_modules": ["files"],
      "actions": [
        "files.read",
        "files.write"
      ],
      "display": {
        "label": "Files",
        "locales": {
          "zh-CN": "文件"
        },
        "icon": "phosphor:folder"
      },
      "description": {
        "label": "Read, edit and manage files",
        "locales": {
          "zh-CN": "读取、编辑与管理文件"
        }
      },
      "desktop": {
        "entry": "dev.sailry.platform/desktop/main.js",
        "resources": [
          "dev.sailry.platform/desktop/actions.js",
          "dev.sailry.platform/desktop/dialogs.js",
          "dev.sailry.platform/desktop/document-view.js",
          "dev.sailry.platform/desktop/documents.js",
          "dev.sailry.platform/desktop/explorer-view.js",
          "dev.sailry.platform/desktop/explorer.js",
          "dev.sailry.platform/desktop/locales.js",
          "dev.sailry.platform/desktop/main.js",
          "dev.sailry.platform/desktop/mutations.js",
          "dev.sailry.platform/desktop/search.js",
          "dev.sailry.platform/desktop/transfers.js"
        ],
        "navigation": {
          "label": "Files",
          "locales": {
            "zh-CN": "文件"
          },
          "icon": "reicon:folders/folder"
        },
        "navigation_options": {
          "pinned": true,
          "order": 400,
          "target": "worktree",
          "details": true
        },
        "panel": {
          "label": "Files",
          "locales": {
            "zh-CN": "文件"
          },
          "icon": "reicon:folders/folder"
        },
        "renderers": [
          {
            "resource": "documents",
            "shortcut": "secondary-p"
          }
        ],
        "previews": [
          "text/html",
          "application/pdf",
          "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
          "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
          "application/vnd.openxmlformats-officedocument.presentationml.presentation",
          "application/x-ipynb+json"
        ]
      },
      "category": "development",
      "tint": "blue"
    }
  }
}
