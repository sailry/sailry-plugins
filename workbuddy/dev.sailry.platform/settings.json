{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "checkin_enabled",
    "checkin_time"
  ],
  "properties": {
    "checkin_enabled": {
      "type": "boolean",
      "title": "Automatic check-in",
      "default": true
    },
    "checkin_time": {
      "type": "string",
      "title": "Check-in time (Asia/Shanghai)",
      "default": "09:05",
      "minLength": 5,
      "maxLength": 5,
      "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$",
      "x-sailry-time": true
    }
  },
  "x-sailry-locales": {
    "en": {
      "checkin_time": "Daily check-in time (Asia/Shanghai)",
      "checkin_enabled": "Automatic check-in"
    },
    "zh-CN": {
      "checkin_time": "每日签到时间（北京时间）",
      "checkin_enabled": "自动签到"
    },
    "zh-TW": {
      "checkin_time": "每日簽到時間（北京時間）",
      "checkin_enabled": "自動簽到"
    },
    "de": {
      "checkin_time": "Tägliche Check-in-Zeit (Asia/Shanghai)",
      "checkin_enabled": "Automatischer Check-in"
    },
    "es": {
      "checkin_time": "Hora diaria de registro (Asia/Shanghai)",
      "checkin_enabled": "Registro automático"
    },
    "fr": {
      "checkin_time": "Heure quotidienne de connexion (Asia/Shanghai)",
      "checkin_enabled": "Connexion automatique"
    },
    "ja": {
      "checkin_time": "毎日のチェックイン時刻（HH:mm、北京時間）",
      "checkin_enabled": "自動チェックイン"
    },
    "ko": {
      "checkin_time": "일일 체크인 시간 (베이징 시간)",
      "checkin_enabled": "자동 체크인"
    },
    "pt-BR": {
      "checkin_time": "Horário diário de check-in (Asia/Shanghai)",
      "checkin_enabled": "Check-in automático"
    },
    "ru": {
      "checkin_time": "Время ежедневной отметки (Asia/Shanghai)",
      "checkin_enabled": "Автоматическая отметка"
    }
  }
}
