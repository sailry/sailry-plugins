{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "web-search",
  "version": "0.1.22",
  "extensions": {
    "dev.sailry.platform": {
      "api_version": "v1",
      "scope": "host",
      "actions": [
        "web.read",
        "web.settings.read",
        "web.settings.write",
        "models.read"
      ],
      "settings_page": {
        "navigation": {
          "label": "Search",
          "locales": {
            "zh-CN": "搜索",
            "zh-TW": "搜尋",
            "ja": "検索",
            "ko": "검색",
            "de": "Suche",
            "es": "Búsqueda",
            "fr": "Recherche",
            "pt-BR": "Pesquisa",
            "ru": "Поиск"
          },
          "icon": "reicon:ui/magnifier"
        },
        "placement": {
          "group": "tools",
          "order": 400
        },
        "enabled_control": true,
        "entry": "dev.sailry.platform/desktop/settings.js"
      },
      "display": {
        "label": "Web search",
        "locales": {
          "zh-CN": "联网搜索"
        },
        "icon": "phosphor:magnifying-glass"
      },
      "description": {
        "label": "Search the web",
        "locales": {
          "zh-CN": "搜索网络内容"
        }
      },
      "desktop": {
        "resources": [
          "dev.sailry.platform/desktop/locales.js",
          "dev.sailry.platform/desktop/settings.js",
          "dev.sailry.platform/desktop/view.js",
          "dev.sailry.platform/desktop/catalog.js"
        ]
      },
      "category": "data",
      "tint": "teal",
      "min_sailry_version": "0.1.6"
    }
  }
}
