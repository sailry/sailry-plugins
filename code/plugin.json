{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "code",
  "version": "0.1.13",
  "extensions": {
    "dev.sailry.platform": {
      "api_version": "v1",
      "min_sailry_version": "0.1.5",
      "actions": [
        "code.index.read",
        "files.read"
      ],
      "display": {
        "label": "Code index",
        "locales": {
          "zh-CN": "代码索引",
          "zh-TW": "程式碼索引",
          "ja": "コード索引",
          "ko": "코드 인덱스",
          "de": "Codeindex",
          "es": "Índice de código",
          "fr": "Index du code",
          "pt-BR": "Índice de código",
          "ru": "Индекс кода"
        },
        "icon": "reicon:it/code"
      },
      "description": {
        "label": "Find code symbols and source context",
        "locales": {
          "zh-CN": "检索代码符号与源码上下文"
        }
      },
      "instructions": "Use code_search to find where functions, types, methods or constants are defined, code_context to get a definition's source with its callers, callees and impact in one call, and code_outline to see one file's declarations before reading it. Use code_impact before changing a symbol, a file line or a set of changed files to see what refers to it, and code_map to orient in an unfamiliar worktree. Callers, callees, impact and the map match references by name without type information: confidence says how a name was matched (local, imported, directory, then workspace) and ambiguous means several definitions share it, so verify important edges in source. These tools read saved source, not strings, comments or dynamic dispatch; use search_files for text and builds or tests for verification. Line numbers in results are 1-based and inclusive, and paths are relative to the current worktree. After a revision conflict, run a fresh search instead of reusing old ranges.",
      "tools": [
        {
          "name": "code_search",
          "operation": "code.search",
          "contexts": [
            "plugin",
            "workspace"
          ],
          "presentation": "summary",
          "description": "Find where functions, types, methods, constants or modules are defined, by name or partial name. Faster and more precise than text search when you know or can guess the identifier. Use code_context or code_impact for call sites and search_files for strings or comments.",
          "display": {
            "label": "Search code",
            "locales": {
              "en": "Search code",
              "zh-CN": "检索代码",
              "zh-TW": "搜尋程式碼",
              "ja": "コードを検索",
              "ko": "코드 검색",
              "de": "Code suchen",
              "es": "Buscar código",
              "fr": "Rechercher du code",
              "pt-BR": "Pesquisar código",
              "ru": "Поиск кода"
            },
            "icon": "reicon:ui/magnifier",
            "input": {
              "summary": {
                "path": "/query"
              }
            }
          }
        },
        {
          "name": "code_outline",
          "operation": "code.outline",
          "contexts": [
            "plugin",
            "workspace"
          ],
          "presentation": "summary",
          "description": "List the declarations in one file (functions, types, methods) with line ranges. Use before reading a large file.",
          "display": {
            "label": "File structure",
            "locales": {
              "en": "File structure",
              "zh-CN": "文件结构",
              "zh-TW": "檔案結構",
              "ja": "ファイル構造",
              "ko": "파일 구조",
              "de": "Dateistruktur",
              "es": "Estructura del archivo",
              "fr": "Structure du fichier",
              "pt-BR": "Estrutura do arquivo",
              "ru": "Структура файла"
            },
            "icon": "reicon:it/code",
            "input": {
              "summary": {
                "path": "/path"
              }
            }
          }
        },
        {
          "name": "code_context",
          "contexts": [
            "plugin",
            "workspace"
          ],
          "presentation": "summary",
          "description": "Find a definition by name and return its source with its callers, callees and impacted files in one call. Use instead of code_search followed by read_file.",
          "handler": {
            "name": "context",
            "read_only": true,
            "flow": {
              "operations": [
                "code.search",
                "code.graph",
                "files.read_lines"
              ]
            },
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "query": {
                  "type": "string",
                  "description": "Literal search terms for names, paths and short signatures."
                },
                "name": {
                  "type": "string",
                  "description": "Literal symbol-name substring."
                },
                "path": {
                  "type": "string",
                  "description": "Worktree-relative path prefix."
                },
                "language": {
                  "type": "string"
                },
                "limit": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 20,
                  "default": 20
                },
                "max_snippets": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 5,
                  "default": 5
                },
                "max_bytes": {
                  "type": "integer",
                  "minimum": 512,
                  "maximum": 16384,
                  "default": 16384
                }
              }
            }
          },
          "display": {
            "label": "Code context",
            "locales": {
              "en": "Code context",
              "zh-CN": "代码上下文",
              "zh-TW": "程式碼上下文",
              "ja": "コードのコンテキスト",
              "ko": "코드 컨텍스트",
              "de": "Codekontext",
              "es": "Contexto del código",
              "fr": "Contexte du code",
              "pt-BR": "Contexto do código",
              "ru": "Контекст кода"
            },
            "icon": "reicon:it/code",
            "input": {
              "summary": {
                "path": "/query"
              }
            }
          }
        },
        {
          "name": "code_impact",
          "contexts": [
            "plugin",
            "workspace"
          ],
          "presentation": "summary",
          "description": "Before changing code, list the definitions and files that refer to a symbol, the definition at a file line, or a set of changed files, up to three reference hops away. References are matched by name; check confidence and ambiguous before relying on an edge.",
          "handler": {
            "name": "impact",
            "read_only": true,
            "flow": {
              "operations": [
                "code.graph"
              ]
            },
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Exact definition name."
                },
                "path": {
                  "type": "string",
                  "description": "Worktree-relative file that defines the symbol; required with line."
                },
                "line": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "1-based line inside the definition in path."
                },
                "paths": {
                  "type": "array",
                  "maxItems": 64,
                  "items": {
                    "type": "string"
                  },
                  "description": "Changed worktree-relative files or directories; every definition they contain is a starting point."
                },
                "depth": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 3,
                  "default": 3
                },
                "limit": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 50,
                  "default": 20
                },
                "offset": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000,
                  "default": 0
                },
                "max_bytes": {
                  "type": "integer",
                  "minimum": 1024,
                  "maximum": 16384,
                  "default": 16384
                }
              }
            }
          },
          "display": {
            "label": "Code impact",
            "locales": {
              "en": "Code impact",
              "zh-CN": "代码影响",
              "zh-TW": "程式碼影響",
              "ja": "コードへの影響",
              "ko": "코드 영향",
              "de": "Codeauswirkungen",
              "es": "Impacto en el código",
              "fr": "Impact sur le code",
              "pt-BR": "Impacto no código",
              "ru": "Влияние на код"
            },
            "icon": "reicon:newicons/hierarchy",
            "input": {
              "summary": {
                "path": "/name"
              }
            }
          }
        },
        {
          "name": "code_map",
          "contexts": [
            "plugin",
            "workspace"
          ],
          "presentation": "summary",
          "description": "Rank the worktree's most referenced files with their key declarations and signatures, for orientation before exploring. Optional paths focus the ranking on files related to them; use next_offset for more files.",
          "handler": {
            "name": "map",
            "read_only": true,
            "flow": {
              "operations": [
                "code.graph"
              ]
            },
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "paths": {
                  "type": "array",
                  "maxItems": 64,
                  "items": {
                    "type": "string"
                  },
                  "description": "Worktree-relative files or directories to focus on."
                },
                "limit": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 50,
                  "default": 20
                },
                "offset": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000,
                  "default": 0
                },
                "max_bytes": {
                  "type": "integer",
                  "minimum": 1024,
                  "maximum": 16384,
                  "default": 16384
                }
              }
            }
          },
          "display": {
            "label": "Code map",
            "locales": {
              "en": "Code map",
              "zh-CN": "代码地图",
              "zh-TW": "程式碼地圖",
              "ja": "コードマップ",
              "ko": "코드 맵",
              "de": "Codeübersicht",
              "es": "Mapa del código",
              "fr": "Carte du code",
              "pt-BR": "Mapa do código",
              "ru": "Карта кода"
            },
            "icon": "reicon:business/diagram-tree"
          }
        }
      ],
      "enabled_service": "code_index",
      "category": "development",
      "tint": "gray",
      "scope": "host",
      "host": {
        "entry": "dev.sailry.platform/host/main.js",
        "resources": [
          "dev.sailry.platform/host/main.js",
          "dev.sailry.platform/host/context.js",
          "dev.sailry.platform/host/graph.js",
          "dev.sailry.platform/host/limits.js"
        ],
        "handlers": [
          "context",
          "impact",
          "map"
        ],
        "read_only": [
          "context",
          "impact",
          "map"
        ]
      }
    }
  }
}
