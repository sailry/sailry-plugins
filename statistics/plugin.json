{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "statistics",
  "version": "0.1.42",
  "extensions": {
    "dev.sailry.platform": {
      "api_version": "v1",
      "min_sailry_version": "0.2.0-alpha.1",
      "actions": [
        "usage.read",
        "conversation.read"
      ],
      "ui": [
        {
          "id": "composer_tokens",
          "slot": "statistics",
          "kind": "metric",
          "label": {
            "label": "Tokens",
            "locales": {
              "zh-CN": "用量"
            }
          },
          "icon": "chart-pie",
          "order": 0
        },
        {
          "id": "composer_speed",
          "slot": "statistics",
          "kind": "metric",
          "label": {
            "label": "Generation speed",
            "locales": {
              "zh-CN": "生成速度",
              "zh-TW": "生成速度",
              "de": "Generierungsgeschwindigkeit",
              "es": "Velocidad de generación",
              "fr": "Vitesse de génération",
              "ja": "生成速度",
              "ko": "생성 속도",
              "pt-BR": "Velocidade de geração",
              "ru": "Скорость генерации"
            }
          },
          "icon": "gauge",
          "order": 10
        },
        {
          "id": "composer_cost",
          "slot": "statistics",
          "kind": "metric",
          "label": {
            "label": "Cost",
            "locales": {
              "zh-CN": "费用"
            }
          },
          "icon": "dollar-sign",
          "order": 20
        },
        {
          "id": "composer_cache",
          "slot": "statistics",
          "kind": "metric",
          "label": {
            "label": "Cache",
            "locales": {
              "zh-CN": "缓存"
            }
          },
          "icon": "memory-stick",
          "order": 30
        },
        {
          "id": "composer_turns",
          "slot": "statistics",
          "kind": "metric",
          "label": {
            "label": "Turns",
            "locales": {
              "zh-CN": "轮次"
            }
          },
          "icon": "messages-square",
          "order": 40
        }
      ],
      "display": {
        "label": "Statistics",
        "locales": {
          "zh-CN": "统计"
        },
        "icon": "phosphor:chart-bar"
      },
      "description": {
        "label": "View session usage and activity",
        "locales": {
          "zh-CN": "查看会话用量与活动"
        }
      },
      "desktop": {
        "ui_shared": true,
        "entry": "dev.sailry.platform/desktop/settings.js",
        "ui_entry": "dev.sailry.platform/desktop/composer.js",
        "resources": [
          "dev.sailry.platform/desktop/breakdown.js",
          "dev.sailry.platform/desktop/charts.js",
          "dev.sailry.platform/desktop/composer.js",
          "dev.sailry.platform/desktop/format.js",
          "dev.sailry.platform/desktop/locales.js",
          "dev.sailry.platform/desktop/metrics.js",
          "dev.sailry.platform/desktop/requests.js",
          "dev.sailry.platform/desktop/settings.js",
          "dev.sailry.platform/desktop/state.js",
          "dev.sailry.platform/desktop/summary.js",
          "dev.sailry.platform/desktop/view.js"
        ],
        "navigation": {
          "label": "Usage",
          "locales": {
            "zh-CN": "用量"
          },
          "icon": "reicon:business/chart-bar"
        },
        "navigation_options": {
          "order": 900,
          "surface": "workspace"
        }
      },
      "category": "data",
      "tint": "blue"
    }
  }
}
