{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "browser",
  "version": "0.1.10",
  "extensions": {
    "dev.sailry.platform": {
      "api_version": "v1",
      "min_sailry_version": "0.1.6",
      "actions": [
        "browser.read",
        "browser.control"
      ],
      "settings_page": {
        "navigation": {
          "label": "Browser",
          "locales": {
            "zh-CN": "浏览器"
          }
        },
        "entry": "dev.sailry.platform/desktop/settings.js"
      },
      "display": {
        "label": "Browser",
        "locales": {
          "zh-CN": "浏览器"
        },
        "icon": "phosphor:browser"
      },
      "description": {
        "label": "Browse websites and preview local pages",
        "locales": {
          "zh-CN": "浏览网页与预览本地页面"
        }
      },
      "desktop": {
        "entry": "dev.sailry.platform/desktop/main.js",
        "resources": [
          "dev.sailry.platform/desktop/address.js",
          "dev.sailry.platform/desktop/annotation.js",
          "dev.sailry.platform/desktop/locales.js",
          "dev.sailry.platform/desktop/main.js",
          "dev.sailry.platform/desktop/settings.js",
          "dev.sailry.platform/desktop/view.js"
        ],
        "panel": {
          "label": "Browser",
          "locales": {
            "zh-CN": "浏览器"
          },
          "icon": "reicon:map/globe"
        },
        "renderers": [
          {
            "resource": "browser",
            "shortcut": "secondary-t"
          }
        ]
      },
      "category": "development",
      "tint": "blue"
    }
  }
}
