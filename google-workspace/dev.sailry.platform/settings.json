{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "gmail_token": {
      "type": "string",
      "title": "Gmail Token",
      "minLength": 1,
      "maxLength": 4096,
      "x-sailry-secret": {
        "origin": "https://gmail.googleapis.com",
        "header": "Authorization",
        "prefix": "Bearer "
      }
    },
    "workspace_token": {
      "type": "string",
      "title": "Workspace Token",
      "minLength": 1,
      "maxLength": 4096,
      "x-sailry-secret": {
        "origin": "https://www.googleapis.com",
        "header": "Authorization",
        "prefix": "Bearer "
      }
    }
  },
