{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "code-review",
  "version": "0.1.22",
  "description": "Review code changes and pull requests with evidence-backed findings",
  "extensions": {
    "dev.sailry.platform": {
      "api_version": "v1",
      "min_sailry_version": "0.1.6",
      "scope": "host",
      "actions": [
        "git.read",
        "conversation.read",
        "storage.read",
        "storage.write",
        "agents.delegate"
      ],
      "display": {
        "label": "Code review",
        "locales": {
          "zh-CN": "代码审查"
        },
        "icon": "phosphor:git-pull-request"
      },
      "description": {
        "label": "Review changes and pull requests",
        "locales": {
          "zh-CN": "审查代码变更与拉取请求"
        }
      },
      "instructions": "For requested code review, load code-review:code-review. Review the frozen capture, batch independent reads and findings, and explicitly attest complete groups. Keep small scopes with one reviewer. Use delegate_review for independent large groups and prefer a role authorized to submit its own receipt. Review records are private and require Code or Flagship mode. A review request alone does not authorize changes or publication.",
      "storage": {
        "collections": [
          {
            "scope": "node",
            "prefix": "review/",
            "schema": {
              "type": "object",
              "required": [
                "v",
                "kind"
              ],
              "properties": {
                "v": {
                  "const": 1
                },
                "kind": {
                  "enum": [
                    "head",
                    "scope",
                    "finding",
                    "receipt",
                    "capture",
                    "content"
                  ]
                }
              }
            }
          }
        ]
      },
      "host": {
        "entry": "dev.sailry.platform/host/main.js",
        "resources": [
          "dev.sailry.platform/host/main.js",
          "dev.sailry.platform/host/policy.js",
          "dev.sailry.platform/host/git.js",
          "dev.sailry.platform/host/filter.js",
          "dev.sailry.platform/host/groups.js",
          "dev.sailry.platform/host/records.js",
          "dev.sailry.platform/host/rules.js",
          "dev.sailry.platform/host/matching.js",
          "dev.sailry.platform/host/scope.js",
          "dev.sailry.platform/host/findings.js",
          "dev.sailry.platform/host/complete.js",
          "dev.sailry.platform/host/locales.js",
          "dev.sailry.platform/host/delegation.js",
          "dev.sailry.platform/host/capture.js",
          "dev.sailry.platform/host/capture/scope.js",
          "dev.sailry.platform/host/content.js",
          "dev.sailry.platform/host/rule-text.js",
          "dev.sailry.platform/host/delivery.js"
        ],
        "handlers": [
          "scope",
          "finding",
          "complete",
          "initialize",
          "delegate",
          "read"
        ],
        "turn": {
          "initialize": "initialize"
        },
        "read_only": [
          "read"
        ]
      },
      "tools": [
        {
          "name": "review_scope",
          "contexts": [
            "workspace"
          ],
          "presentation": "summary",
          "description": "Freeze an immutable review with mapped diffs and saved source context, defaulting to worktree all. Follow any capture continuation and inventory cursor returned. Use the selected rule text supplied once on publication.",
          "handler": {
            "name": "scope",
            "parameters": {
              "type": "object",
              "properties": {
                "target": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "const": "worktree"
                        },
                        "data": {
                          "type": "object",
                          "properties": {
                            "scope": {
                              "enum": [
                                "all",
                                "staged",
                                "unstaged"
                              ]
                            }
                          },
                          "required": [
                            "scope"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "required": [
                        "kind",
                        "data"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "const": "commit"
                        },
                        "data": {
                          "type": "object",
                          "properties": {
                            "revision": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "required": [
                            "revision"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "required": [
                        "kind",
                        "data"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "const": "range"
                        },
                        "data": {
                          "type": "object",
                          "properties": {
                            "base": {
                              "type": "string",
                              "minLength": 1
                            },
                            "head": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "required": [
                            "base",
                            "head"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "required": [
                        "kind",
                        "data"
                      ],
                      "additionalProperties": false
                    }
                  ]
                },
                "review_id": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$"
                },
                "offset": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Row offset for an existing review_id only; use the returned next value."
                },
                "limit": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "Requested rows; each response uses a 100-row output budget and returns next for remaining rows. Allowed when creating the complete frozen scope or reading an existing page."
                }
              },
              "required": [],
              "additionalProperties": false
            }
          },
          "display": {
            "label": "Review scope",
            "locales": {
              "zh-CN": "审查范围",
              "en": "Review scope",
              "zh-TW": "審查範圍",
              "ja": "レビュー範囲",
              "ko": "검토 범위",
              "fr": "Périmètre de révision",
              "de": "Prüfumfang",
              "es": "Alcance de revisión",
              "pt-BR": "Escopo da revisão",
              "ru": "Область проверки"
            },
            "icon": "reicon:it/code"
          }
        },
        {
          "name": "read_review_change",
          "contexts": [
            "workspace"
          ],
          "presentation": "details",
          "description": "Read frozen review evidence. Use paths or group to batch diffs, or path for one diff or an old/new source side. Follow next for the same batch or path. Each file within a batch has its own diff cursor for single-path continuation.",
          "handler": {
            "name": "read",
            "read_only": true,
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "review_id"
              ],
              "properties": {
                "review_id": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$"
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "part": {
                  "enum": [
                    "diff",
                    "old",
                    "new"
                  ],
                  "default": "diff"
                },
                "offset": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "File offset for paths/group, or row offset for path."
                },
                "limit": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "Maximum rows per file in the requested part."
                },
                "paths": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 100,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "group": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "oneOf": [
                {
                  "required": [
                    "path"
                  ]
                },
                {
                  "required": [
                    "paths"
                  ]
                },
                {
                  "required": [
                    "group"
                  ]
                }
              ]
            }
          },
          "display": {
            "label": "Read review change",
            "locales": {
              "zh-CN": "读取审查变更",
              "en": "Read review change",
              "zh-TW": "讀取審查變更",
              "ja": "レビュー変更を読む",
              "ko": "검토 변경 읽기",
              "fr": "Lire le changement examiné",
              "de": "Geprüfte Änderung lesen",
              "es": "Leer cambio revisado",
              "pt-BR": "Ler alteração revisada",
              "ru": "Читать проверяемое изменение"
            },
            "icon": "reicon:it/code",
            "input": {
              "summary": {
                "path": "/path"
              },
              "target": {
                "path": "/path"
              }
            },
            "output": {
              "preview": {
                "parts": [
                  {
                    "value": {
                      "source": "result",
                      "path": "/text"
                    }
                  },
                  {
                    "rows": {
                      "value": {
                        "source": "result",
                        "path": "/lines"
                      },
                      "text": {
                        "parts": [
                          {
                            "text": "+",
                            "when": {
                              "all": [
                                {
                                  "value": {
                                    "source": "item",
                                    "path": "/kind"
                                  },
                                  "equals": "added"
                                }
                              ]
                            }
                          },
                          {
                            "text": "-",
                            "when": {
                              "all": [
                                {
                                  "value": {
                                    "source": "item",
                                    "path": "/kind"
                                  },
                                  "equals": "deleted"
                                }
                              ]
                            }
                          },
                          {
                            "text": " ",
                            "when": {
                              "all": [
                                {
                                  "value": {
                                    "source": "item",
                                    "path": "/kind"
                                  },
                                  "equals": "context"
                                }
                              ]
                            }
                          },
                          {
                            "value": {
                              "source": "item",
                              "path": "/text"
                            }
                          }
                        ]
                      },
                      "separator": "\n"
                    }
                  }
                ],
                "separator": "\n"
              }
            }
          }
        },
        {
          "name": "report_finding",
          "contexts": [
            "workspace"
          ],
          "presentation": "details",
          "description": "Record one or up to 63 evidence-backed findings against frozen changes. Use path, revision, side and a one-based changed line. A snippet is optional and must uniquely match a changed line when included. The batch returns one result per input in order.",
          "handler": {
            "name": "finding",
            "flow": {
              "operations": [
                "storage.transaction"
              ]
            },
            "parameters": {
              "type": "object",
              "properties": {
                "review_id": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$"
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "revision": {
                  "type": "string",
                  "minLength": 1
                },
                "side": {
                  "enum": [
                    "new",
                    "old"
                  ]
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                },
                "snippet": {
                  "type": "string",
                  "minLength": 1
                },
                "severity": {
                  "enum": [
                    "P0",
                    "P1",
                    "P2",
                    "P3"
                  ]
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "explanation": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence": {
                  "type": "string",
                  "minLength": 1
                },
                "findings": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 63,
                  "items": {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "revision": {
                        "type": "string",
                        "minLength": 1
                      },
                      "side": {
                        "enum": [
                          "new",
                          "old"
                        ]
                      },
                      "line": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "snippet": {
                        "type": "string",
                        "minLength": 1
                      },
                      "severity": {
                        "enum": [
                          "P0",
                          "P1",
                          "P2",
                          "P3"
                        ]
                      },
                      "title": {
                        "type": "string",
                        "minLength": 1
                      },
                      "explanation": {
                        "type": "string",
                        "minLength": 1
                      },
                      "evidence": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "path",
                      "revision",
                      "side",
                      "line",
                      "severity",
                      "title",
                      "explanation",
                      "evidence"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "review_id"
              ],
              "additionalProperties": false,
              "oneOf": [
                {
                  "required": [
                    "path",
                    "revision",
                    "side",
                    "line",
                    "severity",
                    "title",
                    "explanation",
                    "evidence"
                  ]
                },
                {
                  "required": [
                    "findings"
                  ]
                }
              ]
            }
          },
          "display": {
            "label": "Report finding",
            "locales": {
              "zh-CN": "记录问题",
              "en": "Report finding",
              "zh-TW": "記錄問題",
              "ja": "問題を記録",
              "ko": "문제 기록",
              "fr": "Signaler un problème",
              "de": "Problem melden",
              "es": "Informar hallazgo",
              "pt-BR": "Relatar problema",
              "ru": "Сообщить о проблеме"
            },
            "icon": "reicon:it/code",
            "input": {
              "summary": {
                "path": "/title",
                "result_path": "/finding/title"
              },
              "target": {
                "path": "/path"
              }
            },
            "output": {
              "preview": {
                "parts": [
                  {
                    "value": {
                      "source": "result",
                      "path": "/finding/severity"
                    }
                  },
                  {
                    "value": {
                      "source": "result",
                      "path": "/finding/path"
                    }
                  },
                  {
                    "value": {
                      "source": "result",
                      "path": "/finding/line"
                    }
                  },
                  {
                    "value": {
                      "source": "result",
                      "path": "/finding/title"
                    }
                  },
                  {
                    "value": {
                      "source": "result",
                      "path": "/finding/explanation"
                    }
                  },
                  {
                    "value": {
                      "source": "result",
                      "path": "/finding/evidence"
                    }
                  },
                  {
                    "value": {
                      "source": "result",
                      "path": "/finding/snippet"
                    }
                  }
                ],
                "separator": "\n"
              }
            }
          }
        },
        {
          "name": "review_complete",
          "contexts": [
            "workspace"
          ],
          "presentation": "summary",
          "description": "Attest complete frozen groups using their IDs and the latest diff delivery token. The host derives file revisions and checks diff delivery. Set finalize:true to record the creator’s last groups and finish in one call. A delegated reviewer uses finalize:false. Explicit reviewed_files receipts remain available for cross-turn and delegated inline evidence.",
          "handler": {
            "name": "complete",
            "flow": {
              "operations": [
                "storage.transaction"
              ]
            },
            "parameters": {
              "type": "object",
              "properties": {
                "review_id": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$"
                },
                "reviewed_files": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "revision": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "path",
                      "revision"
                    ],
                    "additionalProperties": false
                  },
                  "description": "Optional explicit path/revision receipts for complete groups."
                },
                "reviewed_groups": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "finalize": {
                  "type": "boolean"
                },
                "delivery_token": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$",
                  "description": "Latest diff delivery token for this review, using the greatest delivery_sequence. Required for compact group receipts."
                }
              },
              "required": [
                "review_id",
                "reviewed_groups",
                "finalize"
              ],
              "additionalProperties": false
            }
          },
          "display": {
            "label": "Complete review",
            "locales": {
              "zh-CN": "完成审查",
              "en": "Complete review",
              "zh-TW": "完成審查",
              "ja": "レビューを完了",
              "ko": "검토 완료",
              "fr": "Terminer la révision",
              "de": "Prüfung abschließen",
              "es": "Completar revisión",
              "pt-BR": "Concluir revisão",
              "ru": "Завершить проверку"
            },
            "icon": "reicon:it/code"
          }
        },
        {
          "name": "delegate_review",
          "contexts": [
            "workspace"
          ],
          "presentation": "details",
          "description": "Assign complete independent frozen groups in a large review. Prefer a writable, tool-capable role and record_receipt:true so the child can record its own findings and coverage. A read-only role can gather evidence for the creator.",
          "handler": {
            "name": "delegate",
            "operation": "agents.delegate",
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "review_id",
                "groups",
                "record_receipt"
              ],
              "properties": {
                "review_id": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$"
                },
                "groups": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "record_receipt": {
                  "type": "boolean",
                  "description": "Require a formal receipt, or explicitly gather evidence only"
                },
                "role": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Exact key of the captured role responsible for this assignment. Omit when the roster is empty to inherit the current turn and model."
                },
                "background": {
                  "type": "boolean"
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "display": {
            "label": "Delegate review",
            "locales": {
              "zh-CN": "委托审查",
              "en": "Delegate review",
              "zh-TW": "委派審查",
              "ja": "レビューを委任",
              "ko": "검토 위임",
              "fr": "Déléguer la révision",
              "de": "Prüfung delegieren",
              "es": "Delegar revisión",
              "pt-BR": "Delegar revisão",
              "ru": "Делегировать проверку"
            },
            "icon": "reicon:users/users2",
            "input": {
              "summary": {
                "path": "/title"
              },
              "context": {
                "path": "/role"
              }
            }
          }
        }
      ],
      "category": "development",
      "tint": "violet"
    }
  }
}
