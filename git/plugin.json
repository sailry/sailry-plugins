{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "git",
  "version": "0.1.41",
  "extensions": {
    "dev.sailry.platform": {
      "api_version": "v1",
      "min_sailry_version": "0.2.13",
      "products": ["harness", "code"],
      "requires_modules": ["git"],
      "actions": [
        "git.read",
        "git.write",
        "worktrees.read",
        "files.read",
        "conversation.control"
      ],
      "display": {
        "label": "Git",
        "locales": {
          "zh-CN": "Git"
        },
        "icon": "phosphor:git-branch"
      },
      "description": {
        "label": "Review changes and manage repositories",
        "locales": {
          "zh-CN": "审查变更与管理代码仓库"
        }
      },
      "host": {
        "entry": "dev.sailry.platform/host/main.js",
        "resources": [
          "dev.sailry.platform/host/main.js",
          "dev.sailry.platform/host/labels.js"
        ],
        "handlers": [
          "badge"
        ],
        "read_only": [
          "badge"
        ],
        "status": {
          "read": "badge",
          "changes": [
            "repository"
          ]
        }
      },
      "scope": "host",
      "desktop": {
        "entry": "dev.sailry.platform/desktop/main.js",
        "ui_entry": "dev.sailry.platform/desktop/context.js",
        "ui_overlay": true,
        "resources": [
          "dev.sailry.platform/desktop/main.js",
          "dev.sailry.platform/desktop/context.js",
          "dev.sailry.platform/desktop/session-branch.js",
          "dev.sailry.platform/desktop/view.js",
          "dev.sailry.platform/desktop/surfaces.js",
          "dev.sailry.platform/desktop/menus.js",
          "dev.sailry.platform/desktop/actions.js",
          "dev.sailry.platform/desktop/changes.js",
          "dev.sailry.platform/desktop/repository.js",
          "dev.sailry.platform/desktop/locales.js"
        ],
        "navigation": {
          "label": "Git",
          "locales": {
            "zh-CN": "Git"
          },
          "icon": "reicon:newicons/hierarchy2"
        },
        "navigation_options": {
          "pinned": true,
          "order": 500,
          "target": "worktree",
          "details": true
        },
        "panel": {
          "label": "Git",
          "locales": {
            "zh-CN": "Git"
          },
          "icon": {
            "svg": "<svg\n    xmlns=\"http://www.w3.org/2000/svg\"\n    width=\"24\"\n    height=\"24\"\n    viewBox=\"0 0 24 24\"\n    fill=\"none\"\n    stroke=\"currentColor\"\n    stroke-width=\"2\"\n    stroke-linecap=\"round\"\n    stroke-linejoin=\"round\"\n><rect x=\"16\" y=\"16\" width=\"6\" height=\"6\" rx=\"1\" /><rect\n        x=\"2\"\n        y=\"16\"\n        width=\"6\"\n        height=\"6\"\n        rx=\"1\"\n    /><rect x=\"9\" y=\"2\" width=\"6\" height=\"6\" rx=\"1\" /><path\n        d=\"M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3\"\n    /><path d=\"M12 12V8\" /></svg>"
          }
        },
        "renderers": [
          {
            "resource": "git",
            "shortcut": "ctrl-shift-g",
            "create": null
          }
        ]
      },
      "ui": [
        {
          "id": "branch",
          "slot": "context",
          "kind": "menu",
          "label": {
            "label": "Branch",
            "locales": {
              "zh-CN": "分支"
            }
          },
          "icon": "network",
          "handler": "branches",
          "order": 0
        },
        {
          "id": "manage",
          "slot": "project_menu",
          "kind": "button",
          "label": {
            "label": "Manage branches",
            "locales": {
              "zh-CN": "管理分支"
            }
          },
          "icon": "network",
          "handler": "branches",
          "intent": "git_branches",
          "order": 20
        },
        {
          "id": "changes",
          "slot": "status",
          "kind": "button",
          "label": {
            "label": "Git",
            "locales": {
              "zh-CN": "Git"
            }
          },
          "handler": "changes",
          "order": 0
        }
      ],
      "category": "development",
      "tint": "amber"
    }
  }
}
