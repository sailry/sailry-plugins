{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "delegation",
  "version": "0.1.2",
  "extensions": {
    "dev.sailry.platform": {
      "api_version": "v1",
      "actions": [
        "agents.delegate",
        "roles.read",
        "roles.write",
        "models.read"
      ],
      "tools": [
        {
          "name": "spawn_agent",
          "presentation": "details",
          "grouping": "standalone",
          "description": "Delegate a task and await its result. Give it a short display title separate from the full instructions. A new child inherits this turn's project, work mode and permission; select an admitted role and optionally a registered worktree in the same project. To reuse an idle child owned by this conversation, supply its returned session ID. It retains its own history, role, model, worktree and frozen configuration; omit role or select its original role. Busy or foreign children cannot be reused. Children have isolated history and cannot delegate further. Multiple independent calls may run concurrently. Use only when delegation fits the user's instructions.",
          "contexts": [
            "workspace"
          ],
          "handler": {
            "name": "prepare",
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "task"
              ],
              "properties": {
                "session": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                },
                "role": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "task": {
                  "type": "string"
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "worktree": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            "operation": "agents.delegate",
            "result": "result"
          },
          "display": {
            "label": "Subagent",
            "locales": {
              "zh-CN": "子代理"
            },
            "icon": "reicon:users/users2",
            "input": {
              "summary": {
                "path": "/title"
              },
              "context": {
                "path": "/role"
              },
              "content": {
                "path": "/task"
              }
            }
          }
        }
      ],
      "display": {
        "label": "Subagents",
        "locales": {
          "zh-CN": "子代理"
        },
        "icon": "reicon:users/users2"
      },
      "description": {
        "label": "Delegate tasks to subagents",
        "locales": {
          "zh-CN": "将任务分配给子代理"
        }
      },
      "host": {
        "entry": "dev.sailry.platform/host/main.js",
        "resources": [
          "dev.sailry.platform/host/main.js"
        ],
        "handlers": [
          "initialize",
          "prepare",
          "result"
        ],
        "turn": {
          "initialize": "initialize"
        }
      },
      "desktop": {
        "resources": [
          "dev.sailry.platform/desktop/settings.js",
          "dev.sailry.platform/desktop/draft.js",
          "dev.sailry.platform/desktop/view.js",
          "dev.sailry.platform/desktop/locales.js"
        ]
      },
      "settings_page": {
        "navigation": {
          "label": "Subagents",
          "locales": {
            "zh-CN": "子代理"
          },
          "icon": "reicon:users/users2"
        },
        "entry": "dev.sailry.platform/desktop/settings.js",
        "placement": {
          "group": "ai",
          "order": 400
        }
      }
    }
  },
  "description": "Delegate tasks to subagents"
}
