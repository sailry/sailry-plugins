{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "delegation",
  "version": "0.1.14",
  "extensions": {
    "dev.sailry.platform": {
      "api_version": "v1",
      "scope": "host",
      "settings_schema": "dev.sailry.platform/settings.json",
      "conversation_options": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "proactive"
        ],
        "properties": {
          "proactive": {
            "type": "boolean",
            "default": false,
            "x-sailry-import": "delegation_proactive"
          }
        }
      },
      "actions": [
        "agents.delegate",
        "roles.read",
        "roles.write",
        "models.read",
        "conversation.read",
        "conversation.control"
      ],
      "ui": [
        {
          "id": "super",
          "slot": "model",
          "kind": "toggle",
          "label": {
            "label": "Proactive subagents",
            "locales": {
              "zh-CN": "主动使用子代理",
              "zh-TW": "主動使用子代理",
              "de": "Proaktive Unteragenten",
              "es": "Subagentes proactivos",
              "fr": "Sous-agents proactifs",
              "ja": "子エージェントを積極的に使用",
              "ko": "적극적인 하위 에이전트 사용",
              "pt-BR": "Subagentes proativos",
              "ru": "Проактивные субагенты"
            }
          },
          "icon": "bot",
          "handler": "super",
          "order": 0
        }
      ],
      "tools": [
        {
          "name": "list_agents",
          "presentation": "details",
          "contexts": [
            "workspace"
          ],
          "description": "List public agent definitions and exact revisions in this execution Node's catalog. Catalog edits affect new conversations only until explicitly applied; they never rewrite this turn's roster or existing children. No provider configuration or credentials are returned.",
          "handler": {
            "name": "list",
            "read_only": true,
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "properties": {}
            }
          },
          "display": {
            "label": "List agents",
            "locales": {
              "zh-CN": "列出代理",
              "en": "List agents",
              "zh-TW": "列出代理",
              "ja": "エージェントを一覧表示",
              "ko": "에이전트 목록",
              "fr": "Lister les agents",
              "de": "Agenten auflisten",
              "es": "Listar agentes",
              "pt-BR": "Listar agentes",
              "ru": "Список агентов"
            },
            "icon": "reicon:users/users2"
          }
        },
        {
          "name": "add_agent",
          "presentation": "details",
          "contexts": [
            "workspace"
          ],
          "description": "Add an agent definition to this execution Node's catalog. Use a unique lowercase key, display name and instructions. Optional model identifies an existing provider/model, never credentials. This does not change this conversation's roster; use apply_agents only when explicitly requested.",
          "handler": {
            "name": "add",
            "operation": "roles.save",
            "result": "result",
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "key",
                "name",
                "instructions"
              ],
              "properties": {
                "key": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "instructions": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "read_only": {
                  "type": "boolean"
                },
                "model": {
                  "type": [
                    "object",
                    "null"
                  ]
                },
                "max_turns": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1
                },
                "skills": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "appearance": {
                  "type": [
                    "object",
                    "null"
                  ]
                }
              }
            }
          },
          "display": {
            "label": "Add agent",
            "locales": {
              "zh-CN": "添加代理",
              "en": "Add agent",
              "zh-TW": "新增代理",
              "ja": "エージェントを追加",
              "ko": "에이전트 추가",
              "fr": "Ajouter un agent",
              "de": "Agent hinzufügen",
              "es": "Añadir agente",
              "pt-BR": "Adicionar agente",
              "ru": "Добавить агента"
            },
            "icon": "reicon:users/users2",
            "input": {
              "summary": {
                "path": "/name"
              }
            }
          }
        },
        {
          "name": "edit_agent",
          "presentation": "details",
          "contexts": [
            "workspace"
          ],
          "description": "Edit one catalog agent using its exact ID and decimal-string revision from list_agents. Omitted fields are preserved; explicit null clears optional fields. Inspect conflicts instead of silently rebasing. Existing conversations, queued turns and children keep their captures until explicit application for future admission.",
          "handler": {
            "name": "edit",
            "operation": "roles.save",
            "result": "result",
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "expected_revision"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "expected_revision": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*$"
                },
                "key": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "instructions": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "read_only": {
                  "type": "boolean"
                },
                "model": {
                  "type": [
                    "object",
                    "null"
                  ]
                },
                "max_turns": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1
                },
                "skills": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "appearance": {
                  "type": [
                    "object",
                    "null"
                  ]
                }
              }
            }
          },
          "display": {
            "label": "Edit agent",
            "locales": {
              "zh-CN": "编辑代理",
              "en": "Edit agent",
              "zh-TW": "編輯代理",
              "ja": "エージェントを編集",
              "ko": "에이전트 편집",
              "fr": "Modifier un agent",
              "de": "Agent bearbeiten",
              "es": "Editar agente",
              "pt-BR": "Editar agente",
              "ru": "Изменить агента"
            },
            "icon": "reicon:users/users2",
            "input": {
              "summary": {
                "path": "/id"
              }
            }
          }
        },
        {
          "name": "delete_agent",
          "presentation": "details",
          "contexts": [
            "workspace"
          ],
          "description": "Remove exactly one agent definition from this execution Node's catalog using its ID and decimal-string revision from list_agents. Confirm the user's intent before deletion. Existing conversations, queued turns and children retain their immutable definitions and history; this does not delete any conversation or automatically change its roster.",
          "handler": {
            "name": "remove",
            "operation": "roles.remove",
            "result": "result",
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "expected_revision"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "expected_revision": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*$"
                }
              }
            }
          },
          "display": {
            "label": "Delete agent",
            "locales": {
              "zh-CN": "删除代理",
              "en": "Delete agent",
              "zh-TW": "刪除代理",
              "ja": "エージェントを削除",
              "ko": "에이전트 삭제",
              "fr": "Supprimer un agent",
              "de": "Agent löschen",
              "es": "Eliminar agente",
              "pt-BR": "Excluir agente",
              "ru": "Удалить агента"
            },
            "icon": "reicon:users/users2",
            "input": {
              "summary": {
                "path": "/id"
              }
            }
          }
        },
        {
          "name": "apply_agents",
          "presentation": "details",
          "contexts": [
            "workspace"
          ],
          "description": "Explicitly replace this conversation's selected agent roster for future turn admission only. Supply the complete desired list of catalog IDs with exact decimal-string revisions, and this conversation's exact expected_session_revision from initialization or a completed apply_agents receipt. An empty list clears future role selection. Never silently rebase conflicts. This running turn, already queued turns and existing children keep their immutable captures; this cannot target another conversation.",
          "handler": {
            "name": "apply",
            "operation": "roles.apply",
            "result": "result",
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "agents",
                "expected_session_revision"
              ],
              "properties": {
                "agents": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "revision"
                    ],
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "revision": {
                        "type": "string",
                        "pattern": "^[1-9][0-9]*$"
                      }
                    }
                  }
                },
                "expected_session_revision": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*$"
                }
              }
            }
          },
          "display": {
            "label": "Apply agents",
            "locales": {
              "zh-CN": "应用代理",
              "en": "Apply agents",
              "zh-TW": "套用代理",
              "ja": "エージェントを適用",
              "ko": "에이전트 적용",
              "fr": "Appliquer les agents",
              "de": "Agenten anwenden",
              "es": "Aplicar agentes",
              "pt-BR": "Aplicar agentes",
              "ru": "Применить агентов"
            },
            "icon": "reicon:users/users2"
          }
        },
        {
          "name": "spawn_agent",
          "presentation": "details",
          "grouping": "standalone",
          "description": "Delegate a self-contained task to a child agent when the user's instructions allow it. Delegate independent research, implementation or review that benefits from separate context or parallel work; do trivial lookups and tightly coupled steps yourself, and do not redo a child's work. The child does not see this conversation: write a self-contained task with the goal, relevant paths, constraints, whether edits are allowed, and expected output with path:line evidence. Give a short display title separate from the task. By default this observes the child's result within a bounded observation window; use it for results this turn needs and verify them before relying on them. If it returns an admitted, pending child with queued or running status, that work continues under the returned session and turn IDs. Do not spawn it again. Set background to true only when the user asks or long-running work is not needed this turn; it immediately returns the child session ID and queued admission status. The execution Node starts queued children in order as its configured running-child capacity becomes available. This capacity applies independently to each main conversation; waiting for capacity can outlast an observation window. Queued admission is not execution or completion. Do not poll background work: its durable completion arrives as a background notice, and this conversation continues when idle. Until then, report its current status; never claim its results were integrated. Use guide_agent for new directions. A new child inherits this turn's worktree, work mode and permission, including a conversation's private worktree when no project is selected. Choose a role listed in this tool when it fits; use its exact listed key and never invent a role. If no role fits or the roster is empty, omit role or use null to inherit this conversation's model and instructions. worktree selects a registered worktree in this project. If concurrent children could edit the same files, create one with create_worktree and pass its ID; otherwise give children sharing a directory disjoint files. Independent calls may run concurrently. To reuse an idle child owned by this conversation, copy its exact returned session ID and normally omit role; never reconstruct the ID. It keeps its history, role, model, worktree and settings. Busy or foreign children cannot be reused. Children cannot delegate further.",
          "handler": {
            "name": "prepare",
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "task"
              ],
              "properties": {
                "session": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                },
                "role": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "task": {
                  "type": "string"
                },
                "background": {
                  "type": "boolean"
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "worktree": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            "operation": "agents.delegate",
            "result": "result"
          },
          "display": {
            "label": "Subagent",
            "locales": {
              "zh-CN": "子代理",
              "en": "Subagent",
              "zh-TW": "子代理",
              "ja": "サブエージェント",
              "ko": "하위 에이전트",
              "fr": "Sous-agent",
              "de": "Unteragent",
              "es": "Subagente",
              "pt-BR": "Subagente",
              "ru": "Субагент"
            },
            "icon": "reicon:users/users2",
            "input": {
              "summary": {
                "path": "/title"
              },
              "context": {
                "path": "/role"
              },
              "content": {
                "path": "/task"
              }
            }
          }
        },
        {
          "name": "guide_agent",
          "operation": "agents.guide",
          "presentation": "details",
          "grouping": "standalone",
          "description": "Give new directions to a running child owned by this conversation. Copy its exact returned session ID; never reconstruct it. Admission is durable; the child receives them only after its entire current tool batch settles, preserving its history, role, model, worktree and permissions. This does not interrupt an in-flight model response or tool. This returns a queued guidance receipt, not the child's final result. If the child has finished and the user requests follow-up work, use spawn_agent with that session ID and a new task instead.",
          "display": {
            "label": "Guide subagent",
            "locales": {
              "zh-CN": "引导子代理",
              "en": "Guide subagent",
              "zh-TW": "引導子代理",
              "ja": "サブエージェントを指示",
              "ko": "하위 에이전트 지시",
              "fr": "Guider le sous-agent",
              "de": "Unteragent anleiten",
              "es": "Guiar subagente",
              "pt-BR": "Orientar subagente",
              "ru": "Направить субагента"
            },
            "icon": "reicon:users/users2",
            "input": {
              "summary": {
                "path": "/session",
                "format": "session"
              },
              "content": {
                "path": "/message"
              }
            }
          }
        },
        {
          "name": "wait_agent",
          "operation": "agents.wait",
          "presentation": "details",
          "grouping": "standalone",
          "description": "Observe a child owned by this conversation within a bounded observation window and collect its durable final status and answer when available. An admitted, pending response with queued or running status is not failure or completion: the same child continues under its existing session and turn IDs. Do not spawn it again. Use it when the user requests waiting or result collection, or to collect the complete answer from a background notice. Do not poll running background work; its completion arrives as a notice. Guiding background work alone does not request waiting. Copy its exact returned session ID; never reconstruct it. Main-session guidance returns early with guidance_pending so this conversation can apply the user's direction; resume waiting only if the user still requests it. This does not create or replay work.",
          "display": {
            "label": "Wait for subagent",
            "locales": {
              "zh-CN": "等待子代理",
              "en": "Wait for subagent",
              "zh-TW": "等待子代理",
              "ja": "サブエージェントを待機",
              "ko": "하위 에이전트 대기",
              "fr": "Attendre le sous-agent",
              "de": "Auf Unteragent warten",
              "es": "Esperar subagente",
              "pt-BR": "Aguardar subagente",
              "ru": "Ждать субагента"
            },
            "icon": "reicon:users/users2",
            "input": {
              "summary": {
                "path": "/session",
                "format": "session"
              }
            }
          }
        }
      ],
      "display": {
        "label": "Subagents",
        "locales": {
          "zh-CN": "子代理"
        },
        "icon": "reicon:users/users2"
      },
      "description": {
        "label": "Delegate tasks to subagents",
        "locales": {
          "zh-CN": "将任务分配给子代理"
        }
      },
      "host": {
        "entry": "dev.sailry.platform/host/main.js",
        "resources": [
          "dev.sailry.platform/host/main.js",
          "dev.sailry.platform/host/policy.js",
          "dev.sailry.platform/host/roles.js"
        ],
        "handlers": [
          "initialize",
          "prepare",
          "result",
          "list",
          "add",
          "edit",
          "remove",
          "apply"
        ],
        "turn": {
          "initialize": "initialize"
        }
      },
      "desktop": {
        "ui_entry": "dev.sailry.platform/desktop/composer.js",
        "resources": [
          "dev.sailry.platform/desktop/composer.js",
          "dev.sailry.platform/desktop/settings.js",
          "dev.sailry.platform/desktop/capacity.js",
          "dev.sailry.platform/desktop/draft.js",
          "dev.sailry.platform/desktop/view.js",
          "dev.sailry.platform/desktop/locales.js"
        ]
      },
      "settings_page": {
        "navigation": {
          "label": "Subagents",
          "locales": {
            "zh-CN": "子代理"
          },
          "icon": "reicon:users/users2"
        },
        "entry": "dev.sailry.platform/desktop/settings.js",
        "placement": {
          "group": "ai",
          "order": 400
        }
      },
      "category": "automation",
      "tint": "violet"
    }
  },
  "description": "Delegate tasks to subagents"
}
