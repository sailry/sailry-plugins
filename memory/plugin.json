{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "memory",
  "version": "0.1.24",
  "description": "Manage project memory",
  "extensions": {
    "dev.sailry.platform": {
      "api_version": "v1",
      "min_sailry_version": "0.1.6",
      "storage": {
        "collections": [
          {
            "scope": "node",
            "key": "memory/settings",
            "schema": {
              "type": "object",
              "required": [
                "v",
                "settings"
              ],
              "properties": {
                "v": {
                  "const": 1
                },
                "settings": {
                  "type": "object",
                  "properties": {
                    "enabled": {
                      "type": "boolean",
                      "default": true
                    },
                    "auto_write": {
                      "type": "boolean",
                      "default": true
                    },
                    "context_bytes": {
                      "type": "integer",
                      "minimum": 2048,
                      "maximum": 65536,
                      "default": 8192
                    },
                    "review_after_days": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 3650,
                      "default": 90
                    }
                  }
                }
              }
            }
          },
          {
            "scope": "node",
            "key": "memory/catalog",
            "schema": {
              "type": "object",
              "required": [
                "v",
                "pages",
                "active",
                "archived",
                "next"
              ],
              "properties": {
                "v": {
                  "const": 1
                },
                "pages": {
                  "type": "object",
                  "propertyNames": {
                    "pattern": "^(0|[1-9][0-9]*)$"
                  },
                  "additionalProperties": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2
                  }
                },
                "active": {
                  "type": "integer",
                  "minimum": 0
                },
                "archived": {
                  "type": "integer",
                  "minimum": 0
                },
                "next": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          },
          {
            "scope": "node",
            "prefix": "memory/entry/",
            "index": {
              "semantic": true
            },
            "schema": {
              "type": "object",
              "required": [
                "v",
                "summary",
                "hash",
                "body_page",
                "body_revision"
              ],
              "properties": {
                "v": {
                  "const": 1
                },
                "hash": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{16}$"
                },
                "body_page": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                },
                "body_revision": {
                  "type": "integer",
                  "minimum": 1
                },
                "summary": {
                  "type": "object",
                  "required": [
                    "id",
                    "project",
                    "title",
                    "kind",
                    "archived",
                    "revision",
                    "updated_at_ms"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$"
                    },
                    "project": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "title": {
                      "type": "string",
                      "minLength": 1
                    },
                    "kind": {
                      "enum": [
                        "user",
                        "feedback",
                        "project",
                        "reference"
                      ]
                    },
                    "archived": {
                      "type": "boolean"
                    },
                    "revision": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "updated_at_ms": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          },
          {
            "scope": "node",
            "prefix": "memory/body/",
            "schema": {
              "type": "object",
              "required": [
                "v",
                "bodies"
              ],
              "properties": {
                "v": {
                  "const": 1
                },
                "bodies": {
                  "type": "object",
                  "maxProperties": 2,
                  "additionalProperties": {
                    "type": "object",
                    "required": [
                      "body",
                      "revision"
                    ],
                    "properties": {
                      "body": {
                        "type": "string"
                      },
                      "revision": {
                        "type": "integer",
                        "minimum": 1
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "actions": [
        "storage.read",
        "storage.write",
        "projects.read"
      ],
      "display": {
        "label": "Memory",
        "locales": {
          "zh-CN": "记忆"
        },
        "icon": "phosphor:brain"
      },
      "description": {
        "label": "Manage project memory",
        "locales": {
          "zh-CN": "管理项目记忆"
        }
      },
      "settings_page": {
        "navigation": {
          "label": "Memory",
          "locales": {
            "zh-CN": "记忆"
          }
        },
        "placement": {
          "group": "ai",
          "order": 500
        },
        "entry": "dev.sailry.platform/desktop/settings.js"
      },
      "desktop": {
        "resources": [
          "dev.sailry.platform/desktop/settings.js",
          "dev.sailry.platform/desktop/view.js",
          "dev.sailry.platform/desktop/locales.js",
          "dev.sailry.platform/host/policy.js",
          "dev.sailry.platform/host/review.js",
          "dev.sailry.platform/host/tokenize.js",
          "dev.sailry.platform/host/model.js",
          "dev.sailry.platform/host/storage.js",
          "dev.sailry.platform/host/settings.js",
          "dev.sailry.platform/host/retrieval.js",
          "dev.sailry.platform/host/mutations.js"
        ]
      },
      "category": "documents",
      "tint": "violet"
    }
  }
}
