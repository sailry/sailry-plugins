{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "activity-board",
  "version": "0.1.0",
  "description": "View session and terminal activity",
  "extensions": {
    "dev.sailry.platform": {
      "api_version": "v1",
      "scope": "desktop",
      "actions": [
        "activity.read"
      ],
      "display": {
        "label": "Activity Board",
        "locales": {
          "zh-CN": "活动看板"
        },
        "icon": "reicon:ui/grid"
      },
      "description": {
        "label": "View session and terminal activity",
        "locales": {
          "zh-CN": "查看会话和终端活动"
        }
      },
      "desktop": {
        "entry": "dev.sailry.platform/desktop/main.js",
        "resources": [
          "dev.sailry.platform/desktop/main.js",
          "dev.sailry.platform/desktop/state.js",
          "dev.sailry.platform/desktop/view.js",
          "dev.sailry.platform/desktop/locales.js"
        ],
        "navigation": {
          "label": "Activity Board",
          "locales": {
            "zh-CN": "活动看板"
          },
          "icon": "reicon:ui/grid"
        },
        "navigation_options": {
          "pinned": true,
          "order": 100,
          "target": "node"
        }
      },
      "category": "automation",
      "tint": "amber"
    }
  }
}
