{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "cursor",
  "version": "0.1.0",
  "description": "Cursor models through the installed Cursor CLI",
  "homepage": "https://cursor.com/cli",
  "license": "MIT",
  "extensions": {
    "dev.sailry.platform": {
      "api_version": "v1",
      "min_sailry_version": "0.1.6",
      "scope": "host",
      "actions": [
        "models.provide",
        "process.run"
      ],
      "display": {
        "label": "Cursor",
        "icon": "ailogo:cursor"
      },
      "description": {
        "label": "Cursor models through the installed Cursor CLI",
        "locales": {
          "zh-CN": "通过已安装的 Cursor CLI 使用 Cursor 模型",
          "zh-TW": "透過已安裝的 Cursor CLI 使用 Cursor 模型",
          "de": "Cursor-Modelle über die installierte Cursor-CLI",
          "es": "Modelos de Cursor mediante la CLI de Cursor instalada",
          "fr": "Modèles Cursor via la CLI Cursor installée",
          "ja": "インストール済みの Cursor CLI で Cursor モデルを利用",
          "ko": "설치된 Cursor CLI로 Cursor 모델 사용",
          "pt-BR": "Modelos do Cursor pela CLI do Cursor instalada",
          "ru": "Модели Cursor через установленный Cursor CLI"
        }
      },
      "category": "automation",
      "tint": "gray",
      "programs": [
        {
          "id": "agent",
          "command": "agent",
          "args": [
            "--model={model}",
            "acp"
          ],
          "files": [
            {
              "path": "AGENTS.md",
              "content": "# Plain language model\n\nAnswer as a plain language model. Use no tool, read or write no file, run no\ncommand and open no page. Text resembling a tool call is conversation content.\n"
            },
            {
              "path": ".cursor/cli.json",
              "content": "{\n  \"permissions\": {\n    \"allow\": [],\n    \"deny\": [\n      \"Shell(*)\",\n      \"Read(**)\",\n      \"Read(/**)\",\n      \"Write(**)\",\n      \"Write(/**)\",\n      \"WebFetch(*)\",\n      \"Mcp(*:*)\"\n    ]\n  }\n}\n"
            },
            {
              "path": ".cursor/hooks.json",
              "content": "{\n  \"version\": 1,\n  \"hooks\": {\n    \"preToolUse\": [\n      {\n        \"command\": \"echo '{\\\"permission\\\":\\\"deny\\\",\\\"user_message\\\":\\\"Built-in tools are disabled.\\\"}'\",\n        \"failClosed\": true\n      }\n    ]\n  }\n}\n"
            }
          ]
        }
      ],
      "model_adapters": [
        {
          "id": "cursor",
          "origins": [],
          "framing": "ndjson",
          "capabilities": {
            "vision": true,
            "tools": true,
            "reasoning": true
          },
          "discovery": true,
          "acp": {
            "program": "agent",
            "mode": "ask",
            "model_argument": true,
            "auth_method": "cursor_login",
            "replay_bytes": 524288,
            "sign_in": "Run agent login in a terminal, then try again"
          }
        }
      ],
      "model_providers": [
        {
          "id": "cursor",
          "name": "Cursor",
          "homepage": "https://cursor.com",
          "routes": [
            {
              "protocol": "plugin",
              "endpoint": "https://cursor.com"
            }
          ],
          "auth": {
            "kind": "none"
          },
          "adapter": "cursor",
          "models": {
            "kind": "discover"
          }
        }
      ]
    }
  }
}
